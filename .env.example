# Copy to .env and fill in. Validated at boot by src/config/env.ts — a missing
# or malformed value is a startup crash with a readable message, not a 500 later.

NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# --- Postgres ---------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL=postgres://cubeclash:cubeclash@localhost:5432/cubeclash
DATABASE_POOL_MAX=10
DATABASE_SSL=false
#
# On Railway, set this as a *reference* variable to the Postgres service rather
# than pasting a secret:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# Its host is *.railway.internal, which resolves over IPv6 only.

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# On Railway:  REDIS_URL=${{Redis.REDIS_URL}}

# --- Auth -------------------------------------------------------------------
# Two different secrets, both >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-and-make-it-different-32
JWT_REFRESH_TTL=30d

# --- HTTP -------------------------------------------------------------------
# Comma-separated origins, or * in development.
CORS_ORIGINS=*

# --- Observability (optional) -----------------------------------------------
# SENTRY_DSN=
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
